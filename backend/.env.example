# Flask配置
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here

# 服务器配置
HOST=0.0.0.0
PORT=5000

# 文件上传配置
UPLOAD_FOLDER=./uploads
OUTPUT_FOLDER=./outputs
TEMP_FOLDER=./temp
MAX_FILE_SIZE=5000

# TTS配置
TTS_ENGINE=coqui
TTS_LANGUAGE=zh-CN
TTS_MODEL_PATH=./models

# Redis配置（用于Celery队列）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
